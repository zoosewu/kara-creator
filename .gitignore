# Python 環境與快取
.venv/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# worker 在 Windows 上直接執行時，setup.ps1 下載的 ffmpeg
/worker/tools/

# 歌詞、影片與資料備份都有版權：只放在使用者的曲庫與私人的資料 repo，絕對不進這個 repo
/data/

# 前端打包結果由 npm run build 產生（.gitkeep 讓 go:embed 在還沒打包時也能編譯）
nas/internal/api/dist/*
!nas/internal/api/dist/.gitkeep
node_modules/

# compose 沒設定 KARA_SSH_DIR 時掛的空資料夾
deploy/empty-ssh/
